<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="CarrierTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/theme_accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:statusBarColor">@color/theme_background</item>
        <item name="android:navigationBarColor">@color/theme_background</item>
        <item name="android:windowBackground">@color/theme_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:alertDialogTheme">@style/CarrierDialog</item>
    </style>
    <style name="CarrierDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/theme_accent</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorBackground">@color/theme_card</item>
    </style>
</resources>
